{
  "version": 2,
  "rewrites": [
    { "source": "/movie/:id", "destination": "/detail-movie.html" },
    { "source": "/tv/:id", "destination": "/detail-movie.html" }
  ],
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
